# PostgreSQL connection string template for Prisma 7
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=
# Authentication Secret for JWT session cookie signing (Generate a random 32+ char string)
AUTH_SECRET=

# Admin Initial Account Credentials (used by prisma/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=