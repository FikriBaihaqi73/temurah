# PostgreSQL connection string template for Prisma 7
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/temurah_db?schema=public"

# Authentication Secret for JWT session cookie signing (Generate a random 32+ char string)
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
