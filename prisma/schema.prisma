// Prisma Schema for Temurah
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserPreference {
  STUDENT
  HOUSEWIFE
  WORKER
  MSME_OWNER
  GENERAL

  @@map("user_preference")
}

enum StoreType {
  TRADITIONAL_MARKET
  SUPERMARKET
  LOCAL_STORE
  MINIMARKET
  FRUIT_VEGETABLE_STORE

  @@map("store_type")
}

enum PromotionStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  ARCHIVED

  @@map("promotion_status")
}

enum StockCondition {
  PLENTY
  LIMITED
  LOW

  @@map("stock_condition")
}

enum ValidationType {
  VALID
  INVALID
  EXPIRED

  @@map("validation_type")
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.Text
  name         String         @db.VarChar(120)
  avatarUrl    String?        @map("avatar_url") @db.Text
  preference   UserPreference @default(GENERAL)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  stores         Store[]
  promotions     Promotion[]
  validations    PromotionValidation[]
  validationLogs PromotionValidationLog[]
  comments       Comment[]
  bookmarks      UserBookmark[]

  @@index([deletedAt])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotions Promotion[]

  @@map("categories")
}

model Store {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(150)
  storeType       StoreType @map("store_type")
  address         String    @db.Text
  latitude        Float     @db.DoublePrecision
  longitude       Float     @db.DoublePrecision
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promotions    Promotion[]

  @@index([latitude, longitude])
  @@index([storeType, latitude, longitude])
  @@index([createdByUserId])
  @@map("stores")
}

model Promotion {
  id              String          @id @default(uuid()) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  productName     String          @map("product_name") @db.VarChar(200)
  description     String?         @db.Text
  normalPrice     Int             @map("normal_price")
  discountPrice   Int             @map("discount_price")
  imageUrl        String          @map("image_url") @db.Text
  stockCondition  StockCondition  @default(PLENTY) @map("stock_condition")
  startsAt        DateTime        @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime        @map("ends_at") @db.Timestamptz(6)
  status          PromotionStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category       Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser  User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  validations    PromotionValidation[]
  validationLogs PromotionValidationLog[]
  comments       Comment[]
  bookmarks      UserBookmark[]

  @@index([status, endsAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([createdByUserId, createdAt(sort: Desc)])
  @@map("promotions")
}

model PromotionValidation {
  id             String         @id @default(uuid()) @db.Uuid
  promotionId    String         @map("promotion_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  validationType ValidationType @map("validation_type")
  note           String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([promotionId, userId])
  @@index([promotionId, validationType])
  @@index([userId])
  @@map("promotion_validations")
}

model PromotionValidationLog {
  id             String          @id @default(uuid()) @db.Uuid
  promotionId    String          @map("promotion_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  validationType ValidationType? @map("validation_type")
  previousType   ValidationType? @map("previous_type")
  note           String?         @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([promotionId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("promotion_validation_logs")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([promotionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("comments")
}

model UserBookmark {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, promotionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([promotionId])
  @@map("user_bookmarks")
}
